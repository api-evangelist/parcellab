            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.parcellab.com/v4/track/events/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Push a custom event/checkpoint (e.g., warehouse pick, pack, dispatch) into the order timeline. Identifies the order by courier+tracking, account+reference, or account+order_number."
        }
      ]
    },
